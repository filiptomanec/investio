{
  "name": "@investio/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"ESLint configured in T-010\"",
    "test": "vitest run --pool=forks --reporter=verbose",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "prisma": "^6.2.1"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.47.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.41",
    "jsonwebtoken": "^9.0.3",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  }
}
