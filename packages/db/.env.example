# @investio/db — Environment Variables
# Copy to .env and fill with values from `supabase status -o json`
# DO NOT COMMIT .env — it is in .gitignore

# Direct Postgres connection (for Prisma migrations + introspection)
# Local:   postgresql://postgres:postgres@127.0.0.1:<db_port>/postgres
# Remote:  postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"

# Direct URL (bypasses PgBouncer for schema operations).
# Local: same as DATABASE_URL.
# Remote: use the direct connection URL (not the pooler), port 5432.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"

# Supabase project URL (local: http://127.0.0.1:<api_port>)
SUPABASE_URL="http://127.0.0.1:54331"

# Service role key — bypasses RLS for admin/seed operations.
# Get from: supabase status -o json | jq -r .SERVICE_ROLE_KEY
# NEVER expose in client-side code or commit to git.
SUPABASE_SERVICE_ROLE_KEY="<service-role-jwt>"

# Anon (publishable) key — safe for client-side use.
# Get from: supabase status -o json | jq -r .ANON_KEY
SUPABASE_ANON_KEY="<anon-jwt>"

# JWT Secret — used to sign custom JWTs in integration tests.
# Get from: supabase status -o json | jq -r .JWT_SECRET
JWT_SECRET="<jwt-secret>"
