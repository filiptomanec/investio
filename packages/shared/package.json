    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
