# Supabase — mobile client goes directly against PostgREST (no Next.js API hop).
# Copy this file to .env and fill in your project values from Supabase dashboard.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Sentry (optional — leave empty to disable error monitoring)
# Get the DSN from https://sentry.io after creating a React Native project.
EXPO_PUBLIC_SENTRY_DSN=
