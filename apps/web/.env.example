# Supabase — replace with your project values from https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database connection (Supabase Postgres — session mode for Prisma + RLS)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.your-project.supabase.co:5432/postgres

# Sentry (optional — leave empty to disable error monitoring)
# Get these from https://sentry.io after creating a web project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# NEXT_PUBLIC_VERCEL_ENV is set automatically by Vercel; set manually for local testing
NEXT_PUBLIC_VERCEL_ENV=

# Canonical site URL — used for sitemap, robots.txt, OG tags, and rel=canonical.
# Set this in Vercel to the production domain (e.g. https://investio.filiptomanec.cz).
# Defaults to https://investio.filiptomanec.cz if unset.
NEXT_PUBLIC_SITE_URL=https://investio.filiptomanec.cz
